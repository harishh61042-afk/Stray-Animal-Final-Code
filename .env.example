# PawConnect settings.
# 1. Copy this file to a new file named ".env" (start.bat does that for you the first time).
# 2. Type your own MySQL password after DB_PASSWORD=
# 3. Never share or upload the ".env" file. This example file contains no real secrets.

# ---- MySQL (the database must be on a MySQL 8 server that is running) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pawconnect_db
# Instead of the five lines above you may give one complete SQLAlchemy address:
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/pawconnect_db?charset=utf8mb4

# ---- Flask ----
# Any long random text. Create a good one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-text
# development (default) or production
FLASK_CONFIG=development
# 1 = show detailed error pages and reload on code changes (development only)
FLASK_DEBUG=0
# Where the website listens. 127.0.0.1 means this computer only.
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# ---- Default administrator, created by init_db.py when no administrator exists ----
# DEVELOPMENT VALUES ONLY: change the password after the first sign-in (and here, before real use).
ADMIN_EMAIL=admin@pawconnect.test
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=PawConnect Administrator

# ---- Contact details shown on the website: put your real ones here ----
CONTACT_EMAIL=help@pawconnect.test
CONTACT_PHONE=+91 90000 00000
CONTACT_ADDRESS=PawConnect Rescue Desk, India

# ---- Optional ----
# Show times in this offset from UTC, in minutes (330 = India, UTC+05:30).
DISPLAY_UTC_OFFSET_MINUTES=330
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=8
# 1 = load Bootstrap, Chart.js and Leaflet from static/vendor instead of the internet (see README).
USE_LOCAL_VENDOR=0
